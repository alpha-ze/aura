# AURA Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# ─── AI Provider ────────────────────────────────────────────────────────────
# Options: openai | anthropic | gemini | ollama | groq
AI_PROVIDER=groq

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-1.5-pro

# Groq  (fast inference, OpenAI-compatible API)
# Get your key at: https://console.groq.com
GROQ_API_KEY=gsk_...
GROQ_MODEL=qwen/qwen3-27b

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ─── Backend Server ──────────────────────────────────────────────────────────
# IMPORTANT: Always bind to 127.0.0.1 only. Never expose publicly.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8765

# ─── Voice / STT / TTS ──────────────────────────────────────────────────────
# STT provider: whisper_local | whisper_api | azure_stt
STT_PROVIDER=whisper_local
WHISPER_MODEL=base.en

# TTS provider: windows_sapi | piper | azure_tts | elevenlabs
TTS_PROVIDER=windows_sapi

# ─── Permission Mode ────────────────────────────────────────────────────────
# Options: safe | balanced | power_user
PERMISSION_MODE=balanced

# ─── Security ───────────────────────────────────────────────────────────────
# Secret key for local JWT / session signing (generate a random string)
SECRET_KEY=change-me-to-a-random-64-char-string

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=./logs

# ─── Features ───────────────────────────────────────────────────────────────
ENABLE_MEMORY=true
ENABLE_ACTIVITY_LOG=true
ENABLE_VOICE=true
DRY_RUN_DEFAULT=false
